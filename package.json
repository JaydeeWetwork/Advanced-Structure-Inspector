{
	"name": "structure-db-viewer",
	"version": "0.1.0",
	"private": true,
	"description": "Web-based Minecraft Bedrock structure database viewer (local or static host). Adapted from HoloPrint.",
	"type": "module",
	"scripts": {
		"lint": "tsc 2>&1 | grep -Ev 'TS2307|TS2694'",
		"test": "npm run test --workspaces --if-present",
		"build": "npm run build -w pipeline",
		"serve": "npx --yes serve src -p 5173",
		"serve:dist": "npx --yes serve dist -p 5173"
	},
	"workspaces": [
		"pipeline",
		"tests/**"
	],
	"license": "CC-BY-NC-SA-4.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/YOUR_USER/structure-db-viewer.git"
	}
}
