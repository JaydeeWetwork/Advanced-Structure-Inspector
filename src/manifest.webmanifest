{
	"name": "Bedrock Layers",
	"short_name": "Layers",
	"description": "Bedrock Layers — browse, preview, and inspect Minecraft Bedrock .mcstructure files.",
	"categories": ["utilities"],
	"icons": [
		{
			"src": "favicon-32.png",
			"sizes": "32x32",
			"type": "image/png"
		},
		{
			"src": "favicon-48.png",
			"sizes": "48x48",
			"type": "image/png"
		},
		{
			"src": "branding/icons/bedrock-layers-icon-lavender-256.png",
			"sizes": "256x256",
			"type": "image/png"
		},
		{
			"src": "branding/icons/bedrock-layers-icon-lavender-512.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	],
	"start_url": "./",
	"display": "minimal-ui",
	"background_color": "#D7B3D7",
	"theme_color": "#9B4F9B",
	"file_handlers": [
		{
			"accept": {
				"application/mcstructure": [".mcstructure"],
				"application/mcpack": [".mcpack"]
			},
			"action": "./"
		}
	]
}
